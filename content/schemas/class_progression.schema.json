{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "class_progression.schema.json",
  "title": "Class progression",
  "allOf": [{ "$ref": "shared/metadata.schema.json" }],
  "type": "object",
  "required": ["class_id", "levels"],
  "properties": {
    "type": { "const": "class_progression" },
    "class_id": { "type": "string" },
    "levels": { "type": "array", "items": { "type": "object" } }
  }
}
