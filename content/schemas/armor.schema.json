{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "armor.schema.json",
  "title": "Armor",
  "allOf": [{ "$ref": "shared/metadata.schema.json" }],
  "type": "object",
  "required": ["item_base", "armor_class", "dex_allowed", "movement_penalty", "description"],
  "properties": {
    "type": { "const": "armor" },
    "item_base": { "type": "object" },
    "armor_class": { "type": ["integer", "null"] },
    "dex_allowed": { "type": "boolean" },
    "movement_penalty": { "type": ["object", "null"] },
    "description": { "type": "string" }
  }
}
