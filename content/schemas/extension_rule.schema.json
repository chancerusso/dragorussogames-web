{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extension_rule.schema.json",
  "title": "Extension rule",
  "type": "object",
  "required": ["id", "type", "campaign_profile_id", "target_id", "extension_kind", "adds", "notes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
    "type": { "const": "extension_rule" },
    "campaign_profile_id": { "type": "string" },
    "target_id": { "type": "string" },
    "extension_kind": { "type": "string" },
    "adds": { "type": "object" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
