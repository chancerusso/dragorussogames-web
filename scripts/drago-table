#!/usr/bin/env python3
"""Run Drago Table locally from one loopback-only origin."""

from __future__ import annotations

import argparse
import getpass
import json
import os
from pathlib import Path
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import time
from urllib.parse import quote_plus
from urllib.request import urlopen
import webbrowser


REPO_ROOT = Path(__file__).resolve().parents[1]
BACKEND_ROOT = REPO_ROOT / "backend"
FRONTEND_ROOT = REPO_ROOT / "frontend"
DEFAULT_HOST = "127.0.0.1"
DEFAULT_APP_PORT = 8010
DEFAULT_DB_PORT = 55432


def app_home() -> Path:
    configured = os.environ.get("DRAGO_TABLE_HOME")
    return Path(configured).expanduser() if configured else Path.home() / "Library" / "Application Support" / "Drago Table"


def run(command: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> None:
    subprocess.run(command, cwd=cwd, env=env, check=True)


def require_command(name: str) -> str:
    path = shutil.which(name)
    if path is None:
        raise RuntimeError(f"Required command not found: {name}")
    return path


def port_is_open(host: str, port: int) -> bool:
    with socket.socket() as connection:
        connection.settimeout(0.25)
        return connection.connect_ex((host, port)) == 0


def load_or_create_config(home: Path) -> dict[str, str]:
    path = home / "config.json"
    if path.exists():
        return json.loads(path.read_text(encoding="utf-8"))

    password = os.environ.get("DRAGO_TABLE_ADMIN_PASSWORD")
    if not password and sys.stdin.isatty():
        print("First-time setup: choose the Dungeon Master password.")
        while not password:
            first = getpass.getpass("DM password: ")
            second = getpass.getpass("Confirm password: ")
            if first == second and first:
                password = first
            else:
                print("Passwords did not match. Try again.")
    if not password:
        raise RuntimeError(
            "First-time setup needs a DM password. Run interactively or set "
            "DRAGO_TABLE_ADMIN_PASSWORD for this startup."
        )

    config = {
        "admin_password": password,
        "secret_key": secrets.token_urlsafe(48),
        "database_name": "drago_table",
    }
    path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    path.chmod(0o600)
    return config


def initialize_database(home: Path, postgres_bin: str) -> tuple[Path, Path]:
    data = home / "postgres"
    sockets = home / "postgres-socket"
    logs = home / "logs"
    sockets.mkdir(parents=True, exist_ok=True)
    logs.mkdir(parents=True, exist_ok=True)
    if not (data / "PG_VERSION").exists():
        initdb = str(Path(postgres_bin).with_name("initdb"))
        print("Preparing the local Drago Table database…")
        run([initdb, "-D", str(data), "--encoding=UTF8", "--auth=trust", "--no-locale"])
    return data, sockets


def start_database(home: Path, data: Path, sockets: Path, port: int) -> bool:
    pg_ctl = require_command("pg_ctl")
    status = subprocess.run([pg_ctl, "-D", str(data), "status"], capture_output=True)
    if status.returncode == 0:
        return False
    if port_is_open(DEFAULT_HOST, port):
        raise RuntimeError(f"Database port {port} is already in use.")
    logfile = home / "logs" / "postgres.log"
    options = f"-h {DEFAULT_HOST} -p {port} -k '{sockets}'"
    run([pg_ctl, "-D", str(data), "-l", str(logfile), "-o", options, "-w", "start"])
    return True


def ensure_database(config: dict[str, str], port: int) -> str:
    createdb = require_command("createdb")
    name = config["database_name"]
    psql = require_command("psql")
    probe = subprocess.run(
        [
            psql,
            "-h",
            DEFAULT_HOST,
            "-p",
            str(port),
            "-d",
            "postgres",
            "-tAc",
            f"SELECT 1 FROM pg_database WHERE datname = '{name}'",
        ],
        capture_output=True,
        text=True,
    )
    if probe.returncode != 0:
        raise RuntimeError(probe.stderr.strip() or "Unable to inspect the local database.")
    if probe.stdout.strip() != "1":
        create = subprocess.run(
            [createdb, "-h", DEFAULT_HOST, "-p", str(port), name],
            capture_output=True,
            text=True,
        )
        if create.returncode != 0:
            raise RuntimeError(create.stderr.strip() or "Unable to create the local database.")
    user = quote_plus(getpass.getuser())
    return f"postgresql+psycopg2://{user}@{DEFAULT_HOST}:{port}/{name}"


def backend_python() -> str:
    local_python = BACKEND_ROOT / ".venv" / "bin" / "python"
    if local_python.exists():
        return str(local_python)
    try:
        subprocess.run(
            [sys.executable, "-c", "import alembic, fastapi, psycopg2, sqlalchemy, uvicorn"],
            check=True,
            capture_output=True,
        )
        return sys.executable
    except subprocess.CalledProcessError as error:
        raise RuntimeError(
            "Backend dependencies are not installed. Run "
            "`python3 -m venv backend/.venv`, activate it, and install "
            "`backend/requirements.txt`."
        ) from error


def build_frontend() -> None:
    require_command("npm")
    if not (FRONTEND_ROOT / "node_modules").exists():
        raise RuntimeError("Frontend dependencies are not installed. Run `npm install` in frontend.")
    print("Building the local Drago Table interface…")
    run(["npm", "run", "build"], cwd=FRONTEND_ROOT)


def runtime_environment(
    config: dict[str, str], database_url: str, site_root: Path, app_port: int
) -> dict[str, str]:
    environment = os.environ.copy()
    origin = f"http://{DEFAULT_HOST}:{app_port}"
    environment.update(
        {
            "APP_NAME": "Drago Table",
            "RUNTIME_PROFILE": "local",
            "DATABASE_URL": database_url,
            # Every application launch starts a new authenticated session.
            # Persistent campaign data and account passwords remain unchanged.
            "SECRET_KEY": secrets.token_urlsafe(48),
            "ADMIN_PASSWORD": config["admin_password"],
            "SITE_ROOT": str(site_root),
            "COOKIE_SECURE": "false",
            "COOKIE_SAMESITE": "lax",
            "CORS_ORIGINS": origin,
            "CANONICAL_CONTENT_ENABLED": "false",
        }
    )
    return environment


def wait_for_health(url: str, process: subprocess.Popen, timeout: float = 20) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError("Drago Table stopped before its health check passed.")
        try:
            with urlopen(url, timeout=1) as response:
                if response.status == 200:
                    return
        except OSError:
            time.sleep(0.25)
    raise RuntimeError(f"Drago Table did not become healthy at {url}.")


def start(args: argparse.Namespace) -> int:
    home = app_home()
    home.mkdir(parents=True, exist_ok=True)
    config = load_or_create_config(home)
    postgres = require_command("postgres")
    data, sockets = initialize_database(home, postgres)
    database_started = start_database(home, data, sockets, args.database_port)

    app_process: subprocess.Popen | None = None
    try:
        database_url = ensure_database(config, args.database_port)
        python = backend_python()
        if not args.skip_build:
            build_frontend()
        site_root = FRONTEND_ROOT / "dist"
        if not (site_root / "index.html").exists():
            raise RuntimeError("The Drago Table frontend build is missing.")

        environment = runtime_environment(config, database_url, site_root, args.port)
        print("Applying local database updates…")
        run([python, "-m", "alembic", "upgrade", "head"], cwd=BACKEND_ROOT, env=environment)
        if port_is_open(DEFAULT_HOST, args.port):
            raise RuntimeError(f"Application port {args.port} is already in use.")

        command = [
            python,
            "-m",
            "uvicorn",
            "app.main:app",
            "--host",
            DEFAULT_HOST,
            "--port",
            str(args.port),
        ]
        if shutil.which("caffeinate"):
            command = ["caffeinate", "-i", *command]
        app_process = subprocess.Popen(command, cwd=BACKEND_ROOT, env=environment)
        base_url = f"http://{DEFAULT_HOST}:{args.port}"
        wait_for_health(f"{base_url}/api/health", app_process)
        print()
        print("Drago Table is ready.")
        print(f"DM screen:     {base_url}/")
        print(f"Player screen: {base_url}/portal")
        print("Press Control-C here to stop Drago Table cleanly.")
        if not args.no_browser:
            webbrowser.open(base_url)

        def request_stop(_signum, _frame) -> None:
            if app_process and app_process.poll() is None:
                app_process.terminate()

        signal.signal(signal.SIGINT, request_stop)
        signal.signal(signal.SIGTERM, request_stop)
        return_code = app_process.wait()
        return 0 if return_code < 0 else return_code
    finally:
        if app_process and app_process.poll() is None:
            app_process.terminate()
            app_process.wait(timeout=10)
        if database_started:
            print("Stopping the local Drago Table database…")
            run([require_command("pg_ctl"), "-D", str(data), "-w", "stop", "-m", "fast"])


def main() -> int:
    parser = argparse.ArgumentParser(description="Start Drago Table on this Mac.")
    parser.add_argument("--port", type=int, default=DEFAULT_APP_PORT)
    parser.add_argument("--database-port", type=int, default=DEFAULT_DB_PORT)
    parser.add_argument("--skip-build", action="store_true")
    parser.add_argument("--no-browser", action="store_true")
    args = parser.parse_args()
    try:
        return start(args)
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f"Drago Table could not start: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
