#!/bin/zsh

REPOSITORY_PATH="${0:A:h:h}"
TEMPLATE_PATH="$REPOSITORY_PATH/packaging/macos"
INSTALL_PATH="${1:-$HOME/Desktop/Drago Table.app}"
CONTENTS_PATH="$INSTALL_PATH/Contents"
RESOURCES_PATH="$CONTENTS_PATH/Resources"
MACOS_PATH="$CONTENTS_PATH/MacOS"
TEMPORARY_PATH="$(mktemp -d "${TMPDIR:-/tmp}/drago-table-app.XXXXXX")" || exit 1
ICONSET_PATH="$TEMPORARY_PATH/DragoTable.iconset"
SOURCE_ICON="$REPOSITORY_PATH/assets/LogoDrago_Mesa_de_trabajo_1.png"

cleanup() {
  rm -rf "$TEMPORARY_PATH"
}
trap cleanup EXIT

if [[ -e "$INSTALL_PATH" ]]; then
  osascript -e 'display alert "Drago Table is already installed" message "Move the existing Drago Table app to the Trash, then run the installer again."'
  exit 1
fi

mkdir -p "$MACOS_PATH" "$RESOURCES_PATH" "$ICONSET_PATH" || exit 1
cp "$TEMPLATE_PATH/Info.plist" "$CONTENTS_PATH/Info.plist" || exit 1
cp "$TEMPLATE_PATH/Drago Table" "$MACOS_PATH/Drago Table" || exit 1
chmod 755 "$MACOS_PATH/Drago Table"
print -r -- "$REPOSITORY_PATH" > "$RESOURCES_PATH/repository-path"
chmod 600 "$RESOURCES_PATH/repository-path"

sips --cropToHeightWidth 1024 1024 "$SOURCE_ICON" --out "$TEMPORARY_PATH/source.png" >/dev/null || exit 1
for size in 16 32 128 256 512; do
  sips -z "$size" "$size" "$TEMPORARY_PATH/source.png" --out "$ICONSET_PATH/icon_${size}x${size}.png" >/dev/null || exit 1
  double=$((size * 2))
  sips -z "$double" "$double" "$TEMPORARY_PATH/source.png" --out "$ICONSET_PATH/icon_${size}x${size}@2x.png" >/dev/null || exit 1
done
iconutil -c icns "$ICONSET_PATH" -o "$RESOURCES_PATH/DragoTable.icns" || exit 1

touch "$INSTALL_PATH"
echo "Installed Drago Table at: $INSTALL_PATH"
