#!/bin/zsh

REPOSITORY_PATH="${0:A:h:h}"
TEMPLATE_PATH="$REPOSITORY_PATH/packaging/macos"
INSTALL_PATH="${1:-$HOME/Desktop/Drago Table.app}"
CONTENTS_PATH="$INSTALL_PATH/Contents"
RESOURCES_PATH="$CONTENTS_PATH/Resources"
MACOS_PATH="$CONTENTS_PATH/MacOS"
TEMPORARY_PATH="$(mktemp -d "${TMPDIR:-/tmp}/drago-table-app.XXXXXX")" || exit 1

cleanup() {
  rm -rf "$TEMPORARY_PATH"
}
trap cleanup EXIT

if [[ -e "$INSTALL_PATH" ]]; then
  osascript -e 'display alert "Drago Table is already installed" message "Move the existing Drago Table app to the Trash, then run the installer again."'
  exit 1
fi

mkdir -p "$MACOS_PATH" "$RESOURCES_PATH" || exit 1
cp "$TEMPLATE_PATH/Info.plist" "$CONTENTS_PATH/Info.plist" || exit 1
xcrun clang \
  -fobjc-arc \
  -framework Cocoa \
  -fmodules-cache-path="$TEMPORARY_PATH/clang-cache" \
  "$TEMPLATE_PATH/DragoTableApp.m" \
  -o "$MACOS_PATH/DragoTable" || exit 1
chmod 755 "$MACOS_PATH/DragoTable"
print -r -- "$REPOSITORY_PATH" > "$RESOURCES_PATH/repository-path"
chmod 600 "$RESOURCES_PATH/repository-path"

cp "$TEMPLATE_PATH/DragoTable.icns" "$RESOURCES_PATH/DragoTable.icns" || exit 1

xattr -cr "$INSTALL_PATH" || exit 1
codesign --force --deep --sign - "$INSTALL_PATH" || exit 1
touch "$INSTALL_PATH"
echo "Installed Drago Table at: $INSTALL_PATH"
